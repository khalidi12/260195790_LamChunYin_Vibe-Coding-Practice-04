<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MealActivity">

    <!-- 1. ImageView (Logo) -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. TextView (Please click:) -->
    <TextView
        android:id="@+id/tvClickPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Please click:"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Checkbox 1 (Customer 1) -->
    <CheckBox
        android:id="@+id/cbCustomer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer 1"
        app:layout_constraintTop_toBottomOf="@+id/tvClickPrompt"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Checkbox 2 (Customer 2) -->
    <CheckBox
        android:id="@+id/cbCustomer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="Customer 2"
        app:layout_constraintTop_toBottomOf="@+id/tvClickPrompt"
        app:layout_constraintStart_toEndOf="@+id/cbCustomer1" />

    <!-- 4. TextView (Please select one item:) -->
    <TextView
        android:id="@+id/tvSelectPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Please select one item:"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/cbCustomer1"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 5. RadioGroup + 3x RadioButton -->
    <RadioGroup
        android:id="@+id/rgMeals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tvSelectPrompt"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbBreakfast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Breakfast" />

        <RadioButton
            android:id="@+id/rbLunch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunch" />

        <RadioButton
            android:id="@+id/rbDinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dinner" />
    </RadioGroup>

    <!-- 6. Button (Confirm) -->
    <Button
        android:id="@+id/btnMealConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Confirm"
        app:layout_constraintTop_toBottomOf="@+id/rgMeals"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 7. TextView (Result) -->
    <TextView
        android:id="@+id/tvMealResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Please select item:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/btnMealConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 8. Button (Return) -->
    <Button
        android:id="@+id/btnReturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Return"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
